# Environnement
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080
# Sert le frontend depuis Node (utile en local ; en production Apache s'en charge
# pour les pages statiques et ne proxyfie que /api vers Node).
SERVE_FRONTEND=false
# Domaine autorisé (CORS + filtre de l'en-tête Host)
SITE_DOMAIN=lingueredigital.com
# Mettre à 1 derrière un reverse proxy (Cloudflare, cPanel) pour que les
# limiteurs de débit voient la vraie IP cliente. Vaut 1 par défaut en production.
TRUST_PROXY=1

# Base de données
# sqlite en développement ; mysql en production (DB_DIALECT=mysql + NODE_ENV=production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linguere_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=sqlite

# JWT
# OBLIGATOIRE : le serveur refuse de démarrer sans. 32 caractères minimum,
# 64 recommandés. Générer avec :  openssl rand -base64 48
JWT_SECRET=change-this-to-a-64-char-random-string

# Email (Nodemailer SMTP Gmail)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=linguere660@gmail.com

# Seed
# Jeton exigé pour POST /api/seed, dans TOUS les environnements.
# Laisser vide désactive complètement la route.
SEED_TOKEN=

# Admin par défaut (créé via `npm run seed`)
# Il n'existe aucune route d'inscription publique : les comptes se créent
# uniquement par le seed ou directement en base.
